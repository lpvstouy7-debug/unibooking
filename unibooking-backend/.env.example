# Copy to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string used by Prisma (schema.prisma -> datasource db)
DATABASE_URL="postgresql://user:password@localhost:5432/unibooking?schema=public"

# Redis connection used by @nestjs/bullmq (see BullModule.forRootAsync in app.module.ts)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=3000
NODE_ENV=development

# Public origin this API is reachable at -- used only to build the absolute
# `url` returned by POST /uploads/single and /uploads/multiple (see
# src/uploads/storage/local-disk-storage.provider.ts). Falls back to
# http://localhost:3000 if unset.
APP_URL="http://localhost:3000"

# Generate with `openssl rand -base64 48` (or equivalent). Never reuse
# across environments, never commit a real value.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Comma-separated list of origins allowed to send credentialed requests
# (the Nuxt frontend's dev server).
CORS_ORIGIN="http://localhost:3000"

# --- Payments: Stripe (international cards) -----------------------------
# Get test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From `stripe listen --forward-to localhost:3000/payments/webhook/stripe`
# locally, or the Dashboard's webhook endpoint once deployed.
STRIPE_WEBHOOK_SECRET=""
# Absolute frontend URLs Stripe redirects the browser back to after checkout.
STRIPE_SUCCESS_URL="http://localhost:3000/checkout-result"
STRIPE_CANCEL_URL="http://localhost:3000/checkout-result"

# --- Payments: Lao local QR gateway --------------------------------------
# See src/payments/gateways/lao-qr.gateway.ts -- this is a structural
# placeholder until you have BCEL OnePay/LDB/Unitel Money's actual merchant
# integration guide. Leave blank to have that checkout method fail loudly
# with a clear "not configured" error instead of silently misbehaving.
LAO_GATEWAY_BASE_URL=""
LAO_GATEWAY_MERCHANT_ID=""
LAO_GATEWAY_API_KEY=""
LAO_GATEWAY_SECRET=""
LAO_GATEWAY_WEBHOOK_URL="http://localhost:3000/payments/webhook/lao"
