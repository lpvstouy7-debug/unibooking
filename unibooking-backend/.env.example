# Copy to .env and fill in real values. .env is gitignored.

# PostgreSQL connection string used by Prisma (schema.prisma -> datasource db)
DATABASE_URL="postgresql://user:password@localhost:5432/unibooking?schema=public"

# Redis connection used by @nestjs/bullmq (see BullModule.forRootAsync in app.module.ts)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=

PORT=3000
NODE_ENV=development

# Generate with `openssl rand -base64 48` (or equivalent). Never reuse
# across environments, never commit a real value.
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# Comma-separated list of origins allowed to send credentialed requests
# (the Nuxt frontend's dev server).
CORS_ORIGIN="http://localhost:3000"
