generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "linux-musl"]
}

// Prisma 7: the connection string no longer lives here. It's supplied at
// runtime via the driver adapter passed to `new PrismaClient({ adapter })`
// (see src/prisma/prisma.service.ts), and to the CLI (migrate/studio) via
// prisma.config.ts at the project root.
datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// ENUMS (ກຳນົດຄ່າຄົງທີ່)
// -----------------------------------------------------------------------------
enum Role {
  ADMIN
  CUSTOMER
  SUPPLIER
}

enum ServiceType {
  HOTEL
  FLIGHT
  TRAIN
  BUS
  TOUR
  CAR_RENTAL
  PACKAGE // legacy/generic -- not targeted by any vertical controller below
}

enum HotelPropertyType {
  HOTEL
  RESORT
  VILLA
  GUESTHOUSE
}

enum SeatClass {
  ECONOMY
  BUSINESS
  FIRST
}

enum TourDifficulty {
  EASY
  MODERATE
  HARD
}

enum VehicleType {
  SEDAN
  SUV
  VAN
  PICKUP
  MOTORBIKE
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
}

enum BookingStatus {
  PENDING      // ລໍຖ້າຈ່າຍເງິນ (Hold)
  CONFIRMED    // ຈ່າຍສຳເລັດ
  CANCELLED    // ຍົກເລີກ ຫຼື ໝົດເວລາ Hold (BullMQ ຈະປ່ຽນເປັນສະຖານະນີ້)
  COMPLETED    // ໃຊ້ບໍລິການສຳເລັດແລ້ວ
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// -----------------------------------------------------------------------------
// MODELS (ຕາຕະລາງ)
// -----------------------------------------------------------------------------

// 1. Users: ເກັບຂໍ້ມູນຜູ້ໃຊ້ທຸກລະດັບ
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password_hash String
  firstName     String
  lastName      String
  phone         String?
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true) // false = banned/suspended by an admin (see AdminModule)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  supplierProfile Supplier?
  bookings        Booking[]
  reviews         Review[]
}

// 2. Suppliers: ຂໍ້ມູນສະເພາະສຳລັບຄູ່ຄ້າ (ໂຮງແຮມ, ສາຍການບິນ)
model Supplier {
  id             String    @id @default(uuid())
  userId         String    @unique
  companyName    String
  contactEmail   String
  contactPhone   String
  taxId          String?
  isVerified     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  services       Service[]
}

// 3. Services: ບໍລິການຫຼັກ ເຊັ່ນ ໂຮງແຮມ ຫຼື ຖ້ຽວບິນ
model Service {
  id          String       @id @default(uuid())
  supplierId  String
  type        ServiceType
  name        String
  description String       @db.Text
  location    String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  supplier    Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  inventory   InventoryPricing[]

  // Exactly one of these is populated depending on `type` -- enforced by
  // each vertical's create-service flow (HotelsService/TransportService/...),
  // not by a DB constraint, since Prisma has no native "exactly one of these
  // relations" check across separate 1:1 tables.
  hotelDetails     HotelDetails?
  transportDetails TransportDetails?
  tourDetails      TourDetails?
  carRentalDetails CarRentalDetails?
}

// 3a. HotelDetails: attributes specific to ServiceType.HOTEL, split out of
// Service instead of added as nullable columns there so FLIGHT/TOUR/etc
// services never carry hotel-only fields, and so each vertical's Prisma
// filter (see AvailabilitySearchService) targets its own narrow table.
// Nightly price/availability still lives on the shared InventoryPricing --
// not duplicated here.
model HotelDetails {
  serviceId    String            @id
  starRating   Int               @db.SmallInt
  propertyType HotelPropertyType
  amenities    String[] // Postgres text[] -- queried with `hasEvery`/`hasSome`

  service      Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([starRating])
  @@index([propertyType])
}

// 3b. TransportDetails: attributes specific to FLIGHT/TRAIN/BUS. One Service
// row = one sellable leg+class (e.g. "VTE-LPQ VIP Bus, Business" is its own
// Service/InventoryPricing pair), matching how transport ticket SKUs are
// actually priced -- not a single service with per-class sub-pricing.
model TransportDetails {
  serviceId   String    @id
  origin      String
  destination String
  seatClass   SeatClass

  service     Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([origin, destination])
  @@index([seatClass])
}

// 3c. TourDetails: attributes specific to ServiceType.TOUR.
model TourDetails {
  serviceId    String         @id
  durationDays Int
  category     String
  difficulty   TourDifficulty
  minGroupSize Int
  maxGroupSize Int

  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([category])
  @@index([difficulty])
}

// 3d. CarRentalDetails: attributes specific to ServiceType.CAR_RENTAL.
// Daily rate isn't a column here -- it's InventoryPricing.price for the
// pickup date, same mechanism hotels use for nightly price.
model CarRentalDetails {
  serviceId       String            @id
  vehicleType     VehicleType
  transmission    TransmissionType
  seatingCapacity Int

  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([vehicleType])
}

// 4. InventoryPricing: ຈັດການຈຳນວນວ່າງ ແລະ ລາຄາລາຍວັນ (ຫົວໃຈຫຼັກຂອງ OTA)
model InventoryPricing {
  id             String   @id @default(uuid())
  serviceId      String
  date           DateTime @db.Date
  availableUnits Int      @default(0) // ໂຕນີ້ສຳຄັນຫຼາຍ ຈະຖືກໃຊ້ເຮັດ Check Constraint
  price          Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  service        Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookingItems   BookingItem[]

  // ປ້ອງກັນບໍ່ໃຫ້ເພີ່ມວັນທີຊ້ຳກັນໃນບໍລິການດຽວ
  @@unique([serviceId, date]) 
  @@index([date, availableUnits]) //
}

// 5. Promotions: ລະບົບສ່ວນຫຼຸດ
model Promotion {
  id            String   @id @default(uuid())
  code          String   @unique
  discountValue Decimal  @db.Decimal(10, 2)
  discountType  String   // ຕົວຢ່າງ: 'PERCENT' ຫຼື 'FIXED'
  validUntil    DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  bookings      Booking[]
}

// 6. Bookings: ໃບບິນລວມຂອງການຈອງ
model Booking {
  id               String        @id @default(uuid())
  bookingReference String        @unique
  userId           String
  promoId          String?
  status           BookingStatus @default(PENDING)
  totalPrice       Decimal       @db.Decimal(10, 2)
  expiresAt        DateTime      // ຈຸດສຳຄັນ: ເວລາໝົດອາຍຸການ Hold ຫ້ອງ (ສົ່ງໃຫ້ BullMQ)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user             User          @relation(fields: [userId], references: [id])
  promotion        Promotion?    @relation(fields: [promoId], references: [id])
  items            BookingItem[]
  payment          Payment?
}

// 7. BookingItems: ລາຍລະອຽດການຈອງ (ເຊັ່ນ: ຈອງ 2 ຫ້ອງ ໃນວັນທີ 1 ແລະ 2 ຫ້ອງ ໃນວັນທີ 2)
model BookingItem {
  id                 String           @id @default(uuid())
  bookingId          String
  inventoryPricingId String
  quantity           Int              @default(1)
  unitPrice          Decimal          @db.Decimal(10, 2)

  booking            Booking          @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryPricing   InventoryPricing @relation(fields: [inventoryPricingId], references: [id])
  review             Review?
}

// 8. Payments: ຂໍ້ມູນການຊຳລະເງິນ
model Payment {
  id             String        @id @default(uuid())
  bookingId      String        @unique
  transactionId  String?       @unique
  amount         Decimal       @db.Decimal(10, 2)
  method         String        // ຕົວຢ່າງ: 'BCEL_ONE', 'CREDIT_CARD'
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  booking        Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}

// 9. Reviews: ລະບົບຣີວິວສະເພາະຈຸດທີ່ໄປພັກຈິງ
model Review {
  id            String      @id @default(uuid())
  userId        String
  bookingItemId String      @unique
  rating        Int         @db.SmallInt
  comment       String?     @db.Text
  createdAt     DateTime    @default(now())

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookingItem   BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
}